{
  "name": "@doc-agent/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",

    "db:migrate": "node-pg-migrate up",
    "db:migrate:dry": "node-pg-migrate up --dry-run",
    "db:migrate:status": "node scripts/db-status.mjs",
    "db:rollback": "node-pg-migrate down",
    "db:redo": "node-pg-migrate redo",
    "db:create": "node-pg-migrate create"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^5.0.3",
    "ioredis": "^6.0.0",
    "openai": "^4.70.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
